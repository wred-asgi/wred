[Unit]
Description=Wred notebook
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=wred
Group=wred
WorkingDirectory=/srv/wred
EnvironmentFile=/etc/wred/notebook.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/wred/.venv/bin/weft example_app.asgi:app --host 127.0.0.1 --port 8000 --workers 2 --lifespan on --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
